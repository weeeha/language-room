{
  "name": "language-room",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server scripts eval",
    "server": "tsx server/index.ts",
    "eval": "tsx eval/run-gold.ts",
    "eval:stt:synthetic": "tsx eval/stt/run-synthetic.ts",
    "validate:scenarios": "tsx scripts/validate-scenarios.ts",
    "print:prompt": "tsx scripts/print-prompt.ts",
    "timing:tts": "tsx scripts/tts-timing.ts",
    "loop:live": "tsx scripts/loop-live.ts",
    "steps:live": "tsx scripts/steps-live.ts",
    "recap:live": "tsx scripts/recap-live.ts",
    "session:synthetic": "tsx scripts/synthetic-session.ts",
    "check:level": "tsx scripts/check-level.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/three": "0.180.0",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "three": "0.180.0"
  }
}
