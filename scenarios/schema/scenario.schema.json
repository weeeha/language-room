{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language-room.local/scenario.schema.json",
  "title": "Scenario",
  "description": "A language-room scenario (docs/spec.md section 4.1). src/scenario/validate.ts enforces the same rules. A missing reviewed entry is valid but the scenario stays unlisted.",
  "type": "object",
  "required": ["id", "version", "title", "language", "level", "place", "character", "goal", "targets"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/$defs/text" },
    "language": {
      "type": "object",
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "name": { "$ref": "#/$defs/text" }
      }
    },
    "level": { "enum": ["A1", "A2", "B1", "B2"] },
    "place": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "scene": {
          "type": "object",
          "required": ["file", "format", "spawn"],
          "properties": {
            "file": { "$ref": "#/$defs/text" },
            "format": { "enum": ["spz", "ply"] },
            "source": { "$ref": "#/$defs/text" },
            "prompt": { "$ref": "#/$defs/text" },
            "spawn": {
              "type": "object",
              "required": ["position", "lookAt"],
              "properties": {
                "position": { "$ref": "#/$defs/vec3" },
                "lookAt": { "$ref": "#/$defs/vec3" }
              }
            }
          }
        },
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "position", "word", "gloss"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "position": { "$ref": "#/$defs/vec3" },
              "word": { "$ref": "#/$defs/text" },
              "gloss": { "$ref": "#/$defs/text" }
            }
          }
        },
        "signage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "anchor", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "anchor": { "$ref": "#/$defs/vec3" },
              "text": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "character": {
      "type": "object",
      "required": ["name", "role", "persona"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "persona": { "$ref": "#/$defs/text" },
        "voice": {
          "type": "object",
          "properties": {
            "tts": { "$ref": "#/$defs/text" },
            "rate": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "required": ["description", "steps"],
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "hint"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "hint": { "$ref": "#/$defs/text" }
            }
          }
        },
        "completion": { "$ref": "#/$defs/text" }
      }
    },
    "targets": {
      "type": "object",
      "required": ["phrases", "grammar"],
      "properties": {
        "phrases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "grammar": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "reviewed": {
      "type": "object",
      "required": ["by", "on"],
      "properties": {
        "by": { "$ref": "#/$defs/text" },
        "on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
